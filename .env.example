# APIX settings. Copy to .env and fill in your own values.
# This file ships with every key named and empty. No key, no host and no
# client address belongs in the repository.

# Signs and verifies tokens. At least 16 characters. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APIX_SECRET=

# Where the server listens, and where it keeps its data.
APIX_PORT=8080
APIX_DATA=./.data

# Browser origins allowed to call the API cross-origin, comma separated.
# Empty means no cross-origin caller is allowed.
APIX_CORS=

# A database adapter for the connector kit, if your product reads a database.
# The driver lives in your product, not in this repository.
APIX_DB_URL=
APIX_DB_TABLE=
